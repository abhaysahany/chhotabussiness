<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /admin/

    # If the requested resource is index.html, stop rewriting
    RewriteRule ^index\.html$ - [L]

    # If the requested resource exists as a physical file or directory, serve it directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Rewrite all other requests to /admin/index.html for React Router SPA
    RewriteRule . /admin/index.html [L]
</IfModule>
