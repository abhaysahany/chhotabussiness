APP_NAME="Vyapar AdNET"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://vyaparadnet.com
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Hostinger MySQL Database Configuration
# Hostinger web applications must connect via localhost (Unix socket) to match the 'username'@'localhost' MySQL grant.
# Never use 127.0.0.1 on Hostinger, as it attempts TCP authentication which is denied.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u834681197_vyapar_ad_net
DB_USERNAME=u834681197_vyapar_ad_net
DB_PASSWORD=<HOSTINGER_DATABASE_USER_PASSWORD>
DB_TIMEZONE="+05:30"

# Session & Security Settings
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=vyaparadnet.com
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database
CACHE_STORE=database

# Hostinger SMTP Mail Delivery Configuration
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=support@vyaparadnet.com
MAIL_PASSWORD=<HOSTINGER_MAILBOX_PASSWORD>
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=support@vyaparadnet.com
MAIL_FROM_NAME="Vyapar AdNET"
MAIL_LOGO_URL=https://vyaparadnet.com/images/logo-email.png
MAIL_EMBED_LOGO=true

# Google OAuth 2.0 Credentials (User Panel)
GOOGLE_CLIENT_ID=17902999716-9codhpcc55id2hvo49s2n6svrggj5vun.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=NEW_ROTATED_SECRET_TO_BE_INSERTED_PRIVATELY
GOOGLE_REDIRECT_URI=https://vyaparadnet.com
GOOGLE_ALLOWED_ORIGINS=https://vyaparadnet.com,http://localhost:5174,http://127.0.0.1:5174
