# ==============================================================================
# VYAPAR AdNET — CENTRALIZED PRODUCTION ROUTING & SECURITY ARCHITECTURE
# Canonical File Location: backend/public/.htaccess
# Domain: https://vyaparadnet.com
# Target Document Root: backend/public/
# Architecture: User Panel (Root SPA) + Admin SPA + Entity SPA + Laravel 12 API
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # --------------------------------------------------------------------------
    # 0. FastCGI & PHP-FPM Authorization Header Forwarding
    # --------------------------------------------------------------------------
    # Ensure Authorization and X-XSRF-Token headers reach Laravel controllers
    SetEnvIfNoCase ^Authorization$ "(.+)" HTTP_AUTHORIZATION=$1
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # --------------------------------------------------------------------------
    # 1. Security Denial Rules (Source Code, Backups, Dumps & Hidden Files)
    # --------------------------------------------------------------------------
    # Block direct download of archives, backups, dumps, logs, and sensitive extensions
    RewriteRule \.(zip|tar|gz|rar|7z|bak|sql|log|env|ini|conf|sh|ps1)$ - [F,L,NC]

    # Block access to hidden files and dotfiles (e.g. .env, .git), except ACME SSL challenge
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    # Block any directory traversal or direct access to private Laravel framework folders
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage/framework|storage/logs|tests|vendor)(/.*)?$ - [F,L,NC]

    # --------------------------------------------------------------------------
    # 2. Public Static Assets, Uploads & Storage Passthrough
    # --------------------------------------------------------------------------
    # Allow direct access to real physical files and directories across all panels
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # --------------------------------------------------------------------------
    # 3. Laravel API Routing
    # --------------------------------------------------------------------------
    # Direct all /api and /api/* requests directly to Laravel front controller
    # Preserves HTTP method, headers, request body, and query strings [QSA]
    RewriteRule ^api(/.*)?$ index.php [L,QSA]

    # --------------------------------------------------------------------------
    # 4. Admin Panel SPA Routing (/admin/*)
    # --------------------------------------------------------------------------
    # Route non-existent files under /admin/* to admin/index.html
    RewriteCond %{REQUEST_URI} ^/admin
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^admin(/.*)?$ admin/index.html [L]

    # --------------------------------------------------------------------------
    # 5. Entity Panel SPA Routing (/entity/*)
    # --------------------------------------------------------------------------
    # Route non-existent files under /entity/* to entity/index.html
    RewriteCond %{REQUEST_URI} ^/entity
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^entity(/.*)?$ entity/index.html [L]

    # --------------------------------------------------------------------------
    # 6. User Panel SPA Routing (Root Fallback)
    # --------------------------------------------------------------------------
    # Fallback for all other non-existent paths to root User index.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>
