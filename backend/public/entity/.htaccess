<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /entity/

    # Serve real files and directories normally
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Fallback all Entity SPA paths to index.html
    RewriteRule ^.*$ index.html [L]
</IfModule>
