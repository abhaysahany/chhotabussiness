<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Security: Block all direct public web access to .env, source archives, SQL dumps, logs, and backend source directories
    RewriteRule \.(zip|tar|gz|rar|bak|sql|log|env)$ - [F,L]
    RewriteRule ^\.env - [F,L]
    RewriteRule ^backend/\.env - [F,L]
    RewriteRule ^backend/(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/.*)?$ - [F,L]

    # 2. Route all /api/* requests to Laravel backend public index.php
    RewriteRule ^api/(.*)$ backend/public/index.php [L,QSA]
    RewriteRule ^api$ backend/public/index.php [L,QSA]

    # 3. Public uploads and storage routing
    RewriteRule ^uploads/(.*)$ backend/public/uploads/$1 [L]
    RewriteRule ^storage/(.*)$ backend/public/storage/$1 [L]

    # 4. Admin SPA routing: serve real files and directories directly, fallback non-existent /admin/* to admin/index.html
    RewriteCond %{REQUEST_URI} ^/admin
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^admin(/.*)?$ admin/index.html [L]

    # 5. Entity SPA routing: serve real files and directories directly, fallback non-existent /entity/* to entity/index.html
    RewriteCond %{REQUEST_URI} ^/entity
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^entity(/.*)?$ entity/index.html [L]

    # 6. Allow direct access to backend/public/ assets if requested
    RewriteCond %{REQUEST_URI} ^/backend/public(/.*)?$
    RewriteRule ^ - [L]

    # 7. SPA fallback for root User panel
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>
