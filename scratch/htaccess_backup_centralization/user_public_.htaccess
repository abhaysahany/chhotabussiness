<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Route all /api/* requests to Laravel backend public index.php
    RewriteRule ^api/(.*)$ backend/public/index.php [L,QSA]
    RewriteRule ^api$ backend/public/index.php [L,QSA]

    # 2. Security: Block all direct access to sensitive backend directories and .env files
    RewriteRule ^\.env - [F,L]
    RewriteRule ^backend/\.env - [F,L]
    RewriteRule ^backend/(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/.*)?$ - [F,L]

    # Allow direct access to admin, entity, and backend/public sub-applications
    RewriteCond %{REQUEST_URI} ^/admin(/.*)?$ [OR]
    RewriteCond %{REQUEST_URI} ^/entity(/.*)?$ [OR]
    RewriteCond %{REQUEST_URI} ^/backend/public(/.*)?$
    RewriteRule ^ - [L]

    # 3. SPA fallback for root User panel
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>
